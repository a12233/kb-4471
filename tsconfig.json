{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "paths": { "#lib/*": ["./src/lib/*", "./src/lib/*.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
